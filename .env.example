# Supabase Configuration
# Create a project at https://supabase.com and fill these values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Assistant (Gemini via Google AI Studio — https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Service role key (Supabase → Settings → API → "service_role" secret).
# NUNCA prefixar com NEXT_PUBLIC_ — só usada server-side, pela rota de
# exclusão de conta (/api/account).
SUPABASE_SERVICE_ROLE_KEY=
